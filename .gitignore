# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# 测试
.pytest_cache/
.coverage
htmlcov/

# 环境变量（含数据库密码，绝对不能提交）
.env

# 数据（体积大，不进仓库）
data/raw/
data/interim/
data/processed/
*.csv.gz

# 例外：样本数据要进仓库
# （clone 之后没有原始 zip 也能 `streamlit run` 出图，见 scripts/make_sample.py）
!data/sample/
!data/sample/*.csv.gz

# 报告里的临时产物
*.png.tmp

# 运行日志（本地排障用，不进仓库）
*.log

# SQL 查询的输出（跑 run_queries.py 生成，样例见 docs/run-log.md）
reports/queries/

# Streamlit 落盘缓存（persist="disk" 的产物，会到几百 MB）
.streamlit/cache/

# 系统
.DS_Store
Thumbs.db